supabase/.temp/

# Environment files
*.env
*.env.*
!.env.example
!frontend/.env.example

# Debug screenshots and stray patches
ss_*.png
*.patch

# Secrets / credential handoff files (asla commit'lenmemeli)
Client ID.txt
Client Secret.txt
*client*secret*
*secret*.txt

# Agent tooling local state - contains machine-local permission allowlists
# which have historically captured real credentials in command strings.
.claude/settings.local.json
**/settings.local.json

