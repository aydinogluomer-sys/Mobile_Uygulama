# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
#
# `ios/` and `android/` are GENERATED, not authored: this is a managed
# Expo project (main = expo-router/entry) and `npx expo prebuild` writes
# both from app.json plus the config plugins. Neither has ever been
# tracked. They were unignored, so any prebuild -- including the one
# Step 7B needs -- would drop a few hundred untracked files into the
# worktree and invite them into a commit.
/ios/
/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Build artifacts.
#
# EAS writes these when a build runs locally, and they are also what you get
# when you download a cloud build to look inside it. None is authored, every
# one is large, and one of them is a credential: `*.jks` above covers the
# keystores Expo generates, `*.keystore` covers the ones that arrive under
# the other conventional name.
*.apk
*.aab
*.ipa
*.keystore

# Metro
.metro-health-check*
.metro-cache/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
