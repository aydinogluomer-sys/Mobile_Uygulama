{
  "expo": {
    "name": "Aderyth",
    "slug": "aderyth",
    "description": "Alışkanlıklarını irade ekonomisiyle yöneten, ADHD dostu bir karar çerçevesi. Alışkanlık takibi, odak seansları, telafi planları ve haftalık/aylık değerlendirme.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atlas",
    "primaryColor": "#D97757",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aderyth.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.aderyth.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#15140F"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#15140F"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D97757"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Koça yazmak yerine konuşarak soru sorabilmen için mikrofona erişim gerekiyor. Mikrofon yalnızca sen mikrofon düğmesine bastığında açılır.",
          "speechRecognitionPermission": "Söylediklerini yazıya çevirebilmek için konuşma tanıma gerekiyor. Metin, sen göndermeden önce yazı kutusunda düzenlenebilir."
        }
      ],
      "@sentry/react-native",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1de22a6-60f6-478b-8f24-0ae44f2c71ee"
      }
    },
    "owner": "omeraydinoglu"
  }
}
