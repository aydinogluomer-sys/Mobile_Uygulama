{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --ci",
    "test:tz": "node scripts/run-tz-matrix.js",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "typecheck:ci": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit -p tsconfig.ci.json",
    "lint:ci": "eslint . --ext .ts,.tsx --max-warnings=0",
    "audit:prod": "npm audit --omit=dev --audit-level=critical",
    "doctor": "expo-doctor",
    "test:coverage": "jest --ci --coverage",
    "e2e:web:build": "expo export --platform web",
    "e2e:web": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.33",
    "expo-asset": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.25",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.14",
    "expo-notifications": "~57.0.26",
    "expo-router": "~57.0.32",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.12",
    "expo-sqlite": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.29.2",
    "@expo/metro": "~56.0.2",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "1.65.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "19.1.0",
    "@types/sql.js": "1.16.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "sql.js": "1.17.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  }
}
