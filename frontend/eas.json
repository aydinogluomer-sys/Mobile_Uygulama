{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "validation": {
      "node": "22.13.0",
      "distribution": "internal",
      "environment": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "22.13.0",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  }
}
